{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoBergerone/sancho-skill/schemas/team.schema.json",
  "title": "Sancho team",
  "description": "The people working on a project together. Stored at .sancho/team.json; its presence turns team mode on. Each member is recognized by git config user.email (or SANCHO_USER=<id>). Identity is for coordination, not access control.",
  "type": "object",
  "required": [
    "protocol",
    "members"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^sancho/1\\.[0-9]+$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "emails",
          "roles"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/member_id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "emails": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            }
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "analyst-pm",
                "ux-ui-designer",
                "architect",
                "developer",
                "qa",
                "security",
                "release-manager"
              ]
            }
          },
          "coordinator": {
            "type": "boolean",
            "description": "Opens and closes phases and compacts the event log."
          }
        }
      }
    },
    "four_eyes": {
      "type": "boolean",
      "description": "The member who worked on a task cannot review it (default true)."
    },
    "claim_stale_days": {
      "type": "integer",
      "minimum": 1,
      "description": "A claimed task with no event for this many days is shown as stale (default 3)."
    },
    "approvers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "discover": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "specify": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "plan": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "implement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "release": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        },
        "evolve": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_id"
          }
        }
      },
      "description": "Who approves each gate (by phase, or default). Without it, the coordinators approve."
    },
    "quorum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "integer",
          "minimum": 1
        },
        "discover": {
          "type": "integer",
          "minimum": 1
        },
        "specify": {
          "type": "integer",
          "minimum": 1
        },
        "plan": {
          "type": "integer",
          "minimum": 1
        },
        "tasks": {
          "type": "integer",
          "minimum": 1
        },
        "implement": {
          "type": "integer",
          "minimum": 1
        },
        "verify": {
          "type": "integer",
          "minimum": 1
        },
        "release": {
          "type": "integer",
          "minimum": 1
        },
        "evolve": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "How many distinct approvals a gate needs (by phase, or default). Default 1."
    }
  },
  "$defs": {
    "member_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    }
  }
}
