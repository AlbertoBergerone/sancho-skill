{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoBergerone/sancho-skill/schemas/backlog.schema.json",
  "title": "Sancho backlog",
  "description": "Requirements, self-contained stories and tasks of a project. Stored at .sancho/backlog.json. One file so that coherence can be checked end to end.",
  "type": "object",
  "required": ["protocol", "requirements", "stories", "tasks"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "type": "string", "pattern": "^sancho/1\\.[0-9]+$" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "statement", "priority", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R-[0-9]{3,}$" },
          "kind": { "enum": ["functional", "non_functional", "constraint"] },
          "statement": { "type": "string", "minLength": 1 },
          "priority": { "$ref": "#/$defs/moscow" },
          "source": { "enum": ["user", "derived", "regulation", "standard"] },
          "note": { "type": "string" }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "as_a", "i_want", "so_that", "requirements", "priority", "context", "acceptance_criteria"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "as_a": { "type": "string", "minLength": 1 },
          "i_want": { "type": "string", "minLength": 1 },
          "so_that": { "type": "string", "minLength": 1 },
          "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^R-[0-9]{3,}$" } },
          "priority": { "$ref": "#/$defs/moscow" },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "context": {
            "type": "string",
            "minLength": 20,
            "description": "Self-contained context: everything the executing agent needs (relevant decisions, files, standards, constraints) without reading the whole conversation."
          },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "story", "title", "owner", "status", "depends_on", "complexity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]{3,}(\\.[0-9]+)?$" },
          "story": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "owner": { "enum": ["analyst-pm", "ux-ui-designer", "architect", "developer", "qa", "security", "release-manager"] },
          "status": { "enum": ["pending", "in_progress", "blocked", "ready_for_review", "completed", "failed"] },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "parent": { "type": "string", "description": "Set on subtasks created by splitting a task above the complexity threshold." },
          "standards": { "type": "array", "items": { "type": "string" }, "description": "Standards files (relative to .sancho/standards) to load before working on the task." },
          "criteria": { "type": "array", "items": { "type": "string" }, "description": "Acceptance criteria ids covered by this task." },
          "complexity": {
            "type": "object",
            "required": ["score"],
            "additionalProperties": false,
            "properties": {
              "score": { "type": "integer", "minimum": 1, "maximum": 10 },
              "factors": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "files": { "type": "integer", "minimum": 0 },
                  "integrations": { "type": "integer", "minimum": 0 },
                  "unknowns": { "type": "integer", "minimum": 0 },
                  "ui_screens": { "type": "integer", "minimum": 0 },
                  "data_migration": { "type": "boolean" },
                  "security_sensitive": { "type": "boolean" },
                  "no_existing_tests": { "type": "boolean" }
                }
              },
              "rationale": { "type": "string" }
            }
          },
          "blocked_reason": { "type": "string" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
            "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
          },
          {
            "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
            "then": { "required": ["blocked_reason"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "moscow": { "enum": ["must", "should", "could", "wont"] },
    "criterion": {
      "type": "object",
      "required": ["id", "description", "verification", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]{3,}\\.[0-9]+$" },
        "given": { "type": "string" },
        "when": { "type": "string" },
        "then": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "verification": {
          "type": "object",
          "required": ["method"],
          "additionalProperties": false,
          "properties": {
            "method": { "enum": ["automated_test", "uat", "static_check", "review"] },
            "ref": { "type": "string", "description": "Test name/path, UAT case id, or check command." }
          }
        },
        "status": { "enum": ["met", "not_met", "not_verified"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      },
      "if": { "properties": { "status": { "const": "met" } }, "required": ["status"] },
      "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
    },
    "evidence": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["file", "commit", "command", "test", "uat", "url", "log", "screenshot"] },
        "path": { "type": "string" },
        "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "command": { "type": "string" },
        "exit_code": { "type": "integer" },
        "output_excerpt": { "type": "string", "maxLength": 2000 },
        "url": { "type": "string" },
        "ref": { "type": "string" },
        "note": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["file", "screenshot"] } }, "required": ["type"] }, "then": { "required": ["path"] } },
        { "if": { "properties": { "type": { "const": "commit" } }, "required": ["type"] }, "then": { "required": ["commit"] } },
        { "if": { "properties": { "type": { "enum": ["command", "test"] } }, "required": ["type"] }, "then": { "required": ["command"] } },
        { "if": { "properties": { "type": { "const": "uat" } }, "required": ["type"] }, "then": { "required": ["ref"] } },
        { "if": { "properties": { "type": { "const": "url" } }, "required": ["type"] }, "then": { "required": ["url"] } }
      ]
    }
  }
}
