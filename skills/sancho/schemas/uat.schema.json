{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoBergerone/sancho-skill/schemas/uat.schema.json",
  "title": "Sancho UAT checklist",
  "description": "User acceptance test cases derived from acceptance criteria, written for a non-technical tester, plus the defects they produce. Stored at .sancho/uat.json.",
  "type": "object",
  "required": [
    "protocol",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^sancho/1\\.[0-9]+$"
    },
    "build": {
      "type": "string",
      "description": "Version or commit under test."
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "story",
          "criteria",
          "title",
          "platform",
          "preconditions",
          "steps",
          "expected_result",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UAT-[0-9]{3,}$"
          },
          "story": {
            "type": "string",
            "pattern": "^S-[0-9]{3,}$"
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3,}\\.[0-9]+$"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "description": "Platform or device, e.g. web (Chrome), android (Pixel 7, Android 15)."
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "n",
                "action"
              ],
              "additionalProperties": false,
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string"
                }
              }
            }
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_tested"
            ]
          },
          "executed_by": {
            "type": "string"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          },
          "defects": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^DEF-[0-9]{3,}$"
            }
          },
          "assignee": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "Team mode: the member planned to run this case (a suggestion; the claim decides)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "pass",
                    "fail",
                    "blocked"
                  ]
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "required": [
                "executed_at",
                "executed_by"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "const": "fail"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "required": [
                "defects"
              ],
              "properties": {
                "defects": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "const": "blocked"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "required": [
                "notes"
              ]
            }
          }
        ]
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "uat",
          "severity",
          "description",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEF-[0-9]{3,}$"
          },
          "uat": {
            "type": "string",
            "pattern": "^UAT-[0-9]{3,}$"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "steps_to_reproduce": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "fixed",
              "verified",
              "wont_fix"
            ]
          },
          "task": {
            "type": "string"
          },
          "assignee": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "Team mode: the member planned to fix this defect."
          }
        }
      }
    }
  }
}
