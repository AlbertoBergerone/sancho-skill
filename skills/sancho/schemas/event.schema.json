{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoBergerone/sancho-skill/schemas/event.schema.json",
  "title": "Sancho team event",
  "description": "One line of a member's event log, .sancho/log/<member>.jsonl. Lines are only appended, never changed; the current state is the backlog plus all events in time order.",
  "type": "object",
  "required": [
    "at",
    "by",
    "event",
    "task"
  ],
  "additionalProperties": false,
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "by": {
      "$ref": "#/$defs/member_id"
    },
    "event": {
      "enum": [
        "claim",
        "release",
        "task_status",
        "review"
      ]
    },
    "task": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}(\\.[0-9]+)?$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "in_progress",
        "blocked",
        "ready_for_review",
        "failed"
      ]
    },
    "outcome": {
      "enum": [
        "approved",
        "changes"
      ]
    },
    "blocked_reason": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "task_status"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "review"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "outcome"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocked_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready_for_review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "approved"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "changes"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    }
  ],
  "$defs": {
    "member_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "file",
            "commit",
            "command",
            "test",
            "uat",
            "url",
            "log",
            "screenshot"
          ]
        },
        "path": {
          "type": "string"
        },
        "lines": {
          "type": "string",
          "pattern": "^[0-9]+(-[0-9]+)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_excerpt": {
          "type": "string",
          "maxLength": 2000
        },
        "url": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "file",
                  "screenshot"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "commit"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "commit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "command",
                  "test"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "uat"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "url"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    }
  }
}
