{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoBergerone/sancho-skill/schemas/event.schema.json",
  "title": "Sancho team event",
  "description": "One line of a member's event log, .sancho/log/<member>.jsonl. Lines are only appended, never changed; the current state is the backlog and UAT files plus all events in time order.",
  "type": "object",
  "required": [
    "at",
    "by",
    "event"
  ],
  "additionalProperties": false,
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "by": {
      "$ref": "#/$defs/member_id"
    },
    "event": {
      "enum": [
        "claim",
        "release",
        "task_status",
        "review",
        "gate_approve",
        "gate_reject",
        "uat_result",
        "defect_open",
        "defect_status"
      ]
    },
    "task": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}(\\.[0-9]+)?$"
    },
    "case": {
      "type": "string",
      "pattern": "^UAT-[0-9]{3,}$"
    },
    "defect": {
      "type": "string",
      "pattern": "^DEF-[0-9]{3,}$"
    },
    "phase": {
      "enum": [
        "discover",
        "specify",
        "plan",
        "tasks",
        "implement",
        "verify",
        "release",
        "evolve"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "in_progress",
        "blocked",
        "ready_for_review",
        "failed",
        "open",
        "fixed",
        "verified",
        "wont_fix"
      ]
    },
    "outcome": {
      "enum": [
        "approved",
        "changes"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "defects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DEF-[0-9]{3,}$"
      }
    },
    "uat": {
      "type": "string",
      "pattern": "^UAT-[0-9]{3,}$"
    },
    "severity": {
      "enum": [
        "blocker",
        "major",
        "minor",
        "nit"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "steps_to_reproduce": {
      "type": "string"
    },
    "fix_task": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}(\\.[0-9]+)?$"
    },
    "blocked_reason": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "claim"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "task"
            ]
          },
          {
            "required": [
              "case"
            ]
          },
          {
            "required": [
              "defect"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "release"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "task"
            ]
          },
          {
            "required": [
              "case"
            ]
          },
          {
            "required": [
              "defect"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "task_status"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "task",
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "in_progress",
              "blocked",
              "ready_for_review",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "review"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "task",
          "outcome"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "gate_approve"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "phase",
          "iteration"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "gate_reject"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "phase",
          "iteration",
          "note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "uat_result"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "case",
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "defect_open"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "defect",
          "uat",
          "severity",
          "description"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "defect_status"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "defect",
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "open",
              "fixed",
              "verified",
              "wont_fix"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocked_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready_for_review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "approved"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "changes"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "fail"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "defects"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "blocked"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    }
  ],
  "$defs": {
    "member_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "file",
            "commit",
            "command",
            "test",
            "uat",
            "url",
            "log",
            "screenshot"
          ]
        },
        "path": {
          "type": "string"
        },
        "lines": {
          "type": "string",
          "pattern": "^[0-9]+(-[0-9]+)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_excerpt": {
          "type": "string",
          "maxLength": 2000
        },
        "url": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "file",
                  "screenshot"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "commit"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "commit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "command",
                  "test"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "uat"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "url"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    }
  }
}
