{
  "color": {
    "steel": {
      "50": {
        "$value": "#f4f6f8"
      },
      "100": {
        "$value": "#e3e8ee"
      },
      "500": {
        "$value": "#5b6b7c"
      },
      "700": {
        "$value": "#3a4757"
      },
      "900": {
        "$value": "#1c2530"
      }
    },
    "signal": {
      "500": {
        "$value": "#e8590c"
      },
      "700": {
        "$value": "#b8430a"
      }
    },
    "white": {
      "$value": "#ffffff"
    },
    "bg": {
      "default": {
        "$value": "{color.white}"
      },
      "subtle": {
        "$value": "{color.steel.50}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.steel.900}"
      },
      "muted": {
        "$value": "{color.steel.700}"
      },
      "on-action": {
        "$value": "{color.white}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.signal.700}"
      }
    },
    "border": {
      "strong": {
        "$value": "{color.steel.500}"
      }
    }
  },
  "font": {
    "family": {
      "base": {
        "$value": "Inter, system-ui, sans-serif"
      }
    },
    "size": {
      "sm": {
        "$value": "14px"
      },
      "md": {
        "$value": "16px"
      },
      "xl": {
        "$value": "24px"
      }
    }
  },
  "space": {
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "4": {
      "$value": "16px"
    }
  },
  "radius": {
    "md": {
      "$value": "8px"
    }
  },
  "contrast_pairs": [
    {
      "fg": "color.text.default",
      "bg": "color.bg.default",
      "usage": "text"
    },
    {
      "fg": "color.text.muted",
      "bg": "color.bg.default",
      "usage": "text"
    },
    {
      "fg": "color.text.muted",
      "bg": "color.bg.subtle",
      "usage": "text"
    },
    {
      "fg": "color.text.on-action",
      "bg": "color.action.primary",
      "usage": "text"
    },
    {
      "fg": "color.action.primary",
      "bg": "color.bg.default",
      "usage": "ui"
    },
    {
      "fg": "color.border.strong",
      "bg": "color.bg.default",
      "usage": "ui"
    }
  ]
}
